# API and scheduler use the MySQL settings below in every environment.
APP_ENV=local
APP_PORT=8080
FRONTEND_URL=http://localhost:3000

# Local secrets are generated per process when left blank; set unique values to keep sessions across restarts.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=KawahPutih

# Alamat publik BACKEND untuk webhook gateway. Isi URL https publik saat produksi,
# mis. https://api.kawahputih.id — dipakai menyusun URL notifikasi Midtrans.
BACKEND_PUBLIC_URL=http://localhost:8080

# Kredensial merchant: simpan HANYA di env server, jangan pernah di frontend.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Configure a local MySQL database for development; staging/production require every field.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kawah_putih_db
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kawahputih.id

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Optional: create initial staff accounts on first seed. Use unique strong local values.
# superadmin@kawahputih.id dapat mengelola penetapan role via /super-admin/*.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_PETUGAS_PASSWORD=
